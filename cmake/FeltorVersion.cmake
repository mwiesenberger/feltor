# Script mode (cmake -P), run by the target dg_file_version on every build.
# Writes the C++ source file OUTPUT that defines the version strings used by
# dg::file::version_flags (see inc/file/easy_atts.h).
#
# Input variables (-D on the command line):
#   OUTPUT           the file to write
#   SOURCE_DIR       the feltor git repository
#   GIT_EXECUTABLE   git (may be empty if git was not found)
#   PROJECT_VERSION  feltor_version if git describe fails (e.g. no .git)
#
# OUTPUT is only rewritten if its content changes, so that dependent targets
# are rebuilt only after a commit, a branch switch, a new tag or a change
# between a clean and a dirty (uncommitted changes) work tree. The
# compile_time is renewed only when feltor_version changes.

function(feltor_git out)
    set(result "")
    if(GIT_EXECUTABLE)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" ${ARGN}
            WORKING_DIRECTORY "${SOURCE_DIR}"
            RESULT_VARIABLE status
            OUTPUT_VARIABLE result
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        if(NOT status EQUAL 0)
            set(result "")
        endif()
    endif()
    # Escape for a C++ string literal (git allows " but not \ in ref names)
    string(REPLACE "\"" "\\\"" result "${result}")
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

feltor_git(git_hash rev-parse HEAD)
feltor_git(git_branch branch --show-current)
feltor_git(feltor_version describe --tags --always --dirty)
if(feltor_version STREQUAL "")
    set(feltor_version "v${PROJECT_VERSION}")
endif()

set(old_content "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old_content)
endif()
string(REGEX MATCH "feltor_version\\[\\] = \"([^\"]*)\"" _ "${old_content}")
set(old_version "${CMAKE_MATCH_1}")
string(REGEX MATCH "compile_time\\[\\] = \"([^\"]*)\"" _ "${old_content}")
set(compile_time "${CMAKE_MATCH_1}")
if(NOT old_version STREQUAL feltor_version OR compile_time STREQUAL "")
    string(TIMESTAMP compile_time "%Y-%m-%dT%H:%M:%SZ" UTC)
endif()

set(content "// Generated by cmake/FeltorVersion.cmake, do not edit
namespace dg::file::detail
{
extern const char feltor_version[] = \"${feltor_version}\";
extern const char git_hash[] = \"${git_hash}\";
extern const char git_branch[] = \"${git_branch}\";
extern const char compile_time[] = \"${compile_time}\";
} // namespace dg::file::detail
")
if(NOT content STREQUAL old_content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
