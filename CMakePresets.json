{
    "version": 6,
    "configurePresets": [
        {
            "name": "cpu",
            "displayName": "Single core CPU",
            "binaryDir": "build/cpu",
            "cacheVariables": {
                "CCCL_THRUST_DEVICE_SYSTEM": "CPP",
                "CMAKE_CXX_FLAGS": "-march=native -O3"
            }
        },
        {
            "name": "gpu",
            "displayName": "Single GPU",
            "binaryDir": "build/gpu",
            "cacheVariables": {
                "CCCL_THRUST_DEVICE_SYSTEM": "CUDA",
                "CMAKE_CUDA_ARCHITECTURES": "native",
                "CMAKE_CUDA_FLAGS": "-march=native -O3"
            }
        },
        {
            "name": "omp",
            "displayName": "Shared Memory OpenMP",
            "binaryDir": "build/omp",
            "cacheVariables": {
                "CCCL_THRUST_DEVICE_SYSTEM": "OMP",
                "CMAKE_CXX_FLAGS": "-march=native -O3",
                "FELTOR_TEST_OMP_THREADS": "2"
            }
        },
        {
            "name": "mpi-cpu",
            "displayName": "Multi core MPI",
            "binaryDir": "build/mpi-cpu",
            "inherits": "cpu",
            "cacheVariables": {
                "FELTOR_WITH_MPI": "ON",
                "FELTOR_TEST_MPI_RANKS": "2;4;6;8",
                "MPIEXEC_PREFLAGS": "--oversubscribe;--bind-to;none"
            }
        },
        {
            "name": "mpi-gpu",
            "displayName": "Multi core MPI with GPU",
            "binaryDir": "build/mpi-gpu",
            "inherits": "gpu",
            "cacheVariables": {
                "FELTOR_WITH_MPI": "ON",
                "FELTOR_TEST_MPI_RANKS": "2;4;6;8",
                "MPIEXEC_PREFLAGS": "--oversubscribe;--bind-to;none"
            }
        },
        {
            "name": "mpi-omp",
            "displayName": "Multi core MPI with OpenMP",
            "binaryDir": "build/mpi-omp",
            "inherits": "omp",
            "cacheVariables": {
                "FELTOR_WITH_MPI": "ON",
                "FELTOR_TEST_MPI_RANKS": "2;4;6;8",
                "MPIEXEC_PREFLAGS": "--oversubscribe;--bind-to;none"
            }
        },
        {
            "name": "msvc-cpu",
            "displayName": "Single core CPU on Windows",
            "binaryDir": "build/cpu",
            "cacheVariables": {
                "CCCL_THRUST_DEVICE_SYSTEM": "CPP",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_FLAGS": "/arch:AVX2 /O2 /EHsc -D_USE_MATH_DEFINES",
                "FELTOR_DG_WITH_MATRIX": false,
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-omp",
            "displayName": "Shared Memory OpenMP on Windows",
            "binaryDir": "build/omp",
            "cacheVariables": {
                "CCCL_THRUST_DEVICE_SYSTEM": "OMP",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_FLAGS": "/arch:AVX2 /O2 /EHsc -D_USE_MATH_DEFINES",
                "FELTOR_DG_WITH_MATRIX": false,
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-mpi-cpu",
            "displayName": "Multi core MPI on Windows",
            "binaryDir": "build/mpi-cpu",
            "inherits": "msvc-cpu",
            "cacheVariables": {
                "FELTOR_WITH_MPI": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "test-cpu",
            "configurePreset": "cpu",
            "targets": [
                "dg_tests",
                "dg_benchmarks",
                "feltor_projects"
            ]
        },
        {
            "name": "test-omp",
            "configurePreset": "omp",
